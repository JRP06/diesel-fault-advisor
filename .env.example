# watsonx.ai Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# IMPORTANT: No spaces around the '=' sign!
# ✅ CORRECT:   WATSONX_API_KEY=your-key-here
# ❌ INCORRECT: WATSONX_API_KEY = your-key-here

# IBM Cloud API Key
# Get this from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# watsonx.ai Project ID
# Get this from your watsonx.ai project settings
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# Optional: Override default settings
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
# WATSONX_MAX_TOKENS=1000
# WATSONX_TEMPERATURE=0.7